      "tables": [
        {
          "name": "sales",
          "rowCount": 100,
          "columns": [
            { "name": "region", "type": "category", "nullable": false, "sampleValues": ["North", "South"] },
            { "name": "sales_amount", "type": "number", "nullable": false, "sampleValues": [120, 240] }
          ]
        }
      ]
