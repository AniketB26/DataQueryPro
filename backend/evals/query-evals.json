    "id": "mongodb_top_rated_products",
    "dbType": "mongodb",
    "question": "Show top 5 products by rating",
    "schema": {
      "dbType": "mongodb",
      "database": "shop",
      "collections": [
        {
          "name": "products",
          "documentCount": 500,
          "fields": [
            { "name": "_id", "types": ["ObjectId"] },
            { "name": "title", "types": ["string"] },
            { "name": "rating", "types": ["number"], "sampleValues": ["4.8", "4.2"] }
          ]
        }
      ]
    },
    "expected": {
      "contains": ["products", "sort", "rating", "limit"],
      "notContains": ["delete", "update", "insert"]
    }
  },
